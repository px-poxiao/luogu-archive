# ===== 洛谷档案馆 · 后端环境变量示例 =====
# 复制到 .env 并按实际修改。敏感字段用强随机值，不要提交到仓库。

# ---------- 基础 ----------
APP_NAME=luogu-archive
APP_ENV=development                     # development / staging / production
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Shanghai

# ---------- Web 服务 ----------
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_PUBLIC_ORIGIN=http://localhost:3000 # 前端 Nuxt 的访问地址
WEB_CORS_ORIGINS=http://localhost:3000  # 逗号分隔

# ---------- 数据库 ----------
# 开发期本机 MySQL；生产替换为内网地址
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=luogu_archive
DB_PASSWORD=change_me_in_real_env
DB_NAME=luogu_archive
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ---------- Redis（队列 / 缓存 / 限流 / 分布式锁） ----------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 爬虫 ----------
# 默认爬取域名。开发本机访问快走 .com.cn，生产国外服务器走 .com。
CRAWLER_BASE_URL=https://www.luogu.com.cn
CRAWLER_FALLBACK_BASE_URL=https://luogu.com
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/79.0.3945.130 Safari/537.36
CRAWLER_CONTACT_EMAIL=archive-bot@example.com  # 部署前替换
CRAWLER_ANON_RATE_PER_SEC=0.33                 # 游客：1 req / 3s
CRAWLER_AUTH_RATE_PER_SEC=0.17                 # 认证：1 req / 6s
CRAWLER_AUTH_QPH_PER_ACCOUNT=300               # 单账号每小时 ≤ 300
CRAWLER_BREAKER_COOLDOWN_SEC=300               # 被封后冷却 5 min
CRAWLER_GLOBAL_BREAKER_NODE_THRESHOLD=3        # 连续 3 节点被封 → 全局冷却
CRAWLER_TASK_LOCK_TTL_SEC=30                   # 同 URL 幂等锁
CRAWLER_REQUEST_TIMEOUT_SEC=15

# ---------- 陶片同项合并窗口 ----------
JUDGEMENT_GROUP_TIME_WINDOW_SEC=1800           # 30 min

# ---------- 管理员 ----------
ADMIN_2FA_ISSUER=LuoguArchive                  # TOTP app 里显示的 issuer
ADMIN_SESSION_MAX_AGE_SEC=3600                 # 管理员 session 1 小时
ADMIN_TOTP_ENCRYPTION_KEY=change_me_to_fernet_key  # Fernet key，用 `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"` 生成

# ---------- JWT ----------
JWT_SECRET=change_me_to_random_256bit_hex
JWT_ACCESS_TTL_SEC=900                         # 15 min
JWT_REFRESH_TTL_SEC=604800                     # 7 day

# ---------- 邮件 ----------
# 发送后端：resend（HTTP API，推荐，走 443 不易被墙）或 smtp（aiosmtplib）
MAIL_PROVIDER=smtp
MAIL_FROM=noreply@example.com                  # 发件人，须为已验证域名下的地址

# Resend HTTP API（MAIL_PROVIDER=resend 时用）
RESEND_API_KEY=

# 传统 SMTP（MAIL_PROVIDER=smtp 时用）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=change_me
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true

# ---------- 人机验证 ----------
CAPTCHA_PROVIDER=turnstile                     # turnstile / hcaptcha / aliyun / none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
CAPTCHA_ALIYUN_ACCESS_KEY_ID=
CAPTCHA_ALIYUN_ACCESS_KEY_SECRET=
CAPTCHA_ALIYUN_SCENE_ID=
CAPTCHA_ALIYUN_REGION=cn                       # cn / sgp
CAPTCHA_ALIYUN_ENDPOINT=                       # 留空时按 region 自动选择
CAPTCHA_TRIGGER_SAVE_PER_MIN=3
CAPTCHA_TRIGGER_SAVE_PER_10MIN=10
CAPTCHA_TRIGGER_PAGE_PER_HOUR=600

# ---------- 保存按钮限流 ----------
SAVE_IP_WINDOW_SEC=60
SAVE_IP_WINDOW_MAX=20
SAVE_IP_HOUR_BREAKER_THRESHOLD=10
SAVE_IP_HOUR_BREAKER_COOLDOWN_SEC=3600

# ---------- 图片镜像 ----------
IMAGE_MIRROR_DIR=./data/image_mirror            # 本地存储路径
IMAGE_MIRROR_PUBLIC_PREFIX=/static/img          # 前端访问 URL 前缀
IMAGE_MIRROR_MAX_SIZE_MB=20

# ---------- 数据存储路径 ----------
DATA_DIR=./data
