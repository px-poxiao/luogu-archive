# 洛谷档案馆 · 前端环境变量
# 复制到 .env 使用

# 后端 API（服务端 SSR 用，一般是本地内网地址）
NUXT_API_INTERNAL_URL=http://127.0.0.1:8001

# 后端 API（浏览器用）
NUXT_PUBLIC_API_BASE_URL=

# 人机验证
NUXT_PUBLIC_CAPTCHA_PROVIDER=turnstile          # turnstile / hcaptcha / aliyun / none
NUXT_PUBLIC_CAPTCHA_SITE_KEY=
NUXT_PUBLIC_CAPTCHA_ALIYUN_PREFIX=
NUXT_PUBLIC_CAPTCHA_ALIYUN_SCENE_ID=
NUXT_PUBLIC_CAPTCHA_ALIYUN_REGION=cn            # cn / sgp
