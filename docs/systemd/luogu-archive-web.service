# 部署路径：/etc/systemd/system/luogu-archive-web.service
# 启动 FastAPI 主服务（uvicorn）
# sudo systemctl enable --now luogu-archive-web

[Unit]
Description=luogu-archive web (FastAPI)
After=network.target mysql.service redis.service

[Service]
Type=simple
User=luogu
Group=luogu
WorkingDirectory=/srv/luogu-archive/backend
EnvironmentFile=/srv/luogu-archive/backend/.env
ExecStart=/srv/luogu-archive/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
# 不允许写全局，限制在工作目录 + data dir
ReadWritePaths=/srv/luogu-archive/backend /var/www/luogu-archive
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
# 日志
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
